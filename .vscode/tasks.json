{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "esbuild watch",
			"detail": "Bundle client + server with esbuild and rebuild on change",
			"type": "npm",
			"script": "watch",
			"isBackground": true,
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"reveal": "never",
				"group": "watch"
			},
			"problemMatcher": {
				"owner": "esbuild",
				"source": "esbuild",
				"fileLocation": ["autoDetect", "${workspaceFolder}"],
				"pattern": [
					{
						"regexp": "^✘ \\[ERROR\\] (.+)$",
						"message": 1
					},
					{
						"regexp": "^\\s+(.+):(\\d+):(\\d+):$",
						"file": 1,
						"line": 2,
						"column": 3
					}
				],
				"background": {
					"activeOnStart": true,
					"beginsPattern": "^\\[watch\\] build started$",
					"endsPattern": "^\\[watch\\] build finished$"
				}
			}
		},
		{
			"label": "type-check watch",
			"detail": "Report TypeScript errors on change (no emit needed for the bundle)",
			"type": "npm",
			"script": "watch:tsc",
			"isBackground": true,
			"group": "build",
			"presentation": {
				"reveal": "never",
				"group": "watch"
			},
			"problemMatcher": "$tsc-watch"
		}
	]
}
